# Copy to .env.local and fill in. NEVER commit real values.
# Variables marked (Mx) are first used in that milestone.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (M1) — Project Settings → API Keys -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or legacy service_role key. SERVER ONLY. Bypasses RLS.
SUPABASE_SECRET_KEY=
# Project ref, used by `npm run db:types`
SUPABASE_PROJECT_REF=

# --- Auth (M1) -----------------------------------------------------------------
# Set to true after configuring the Google provider in Supabase Auth.
AUTH_GOOGLE_ENABLED=false

# --- Consent tokens (M7) -------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -base64 48`
CONSENT_TOKEN_SECRET=

# --- Razorpay (M5) — use rzp_test_… keys in development ---------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Email via Resend (M5/M7) -------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="AI Learning Hub <hello@example.com>"

# --- Storage buckets (M3/M5) ----------------------------------------------------
SUPABASE_INVOICES_BUCKET=invoices
SUPABASE_SUBMISSIONS_BUCKET=submissions

# --- Testing ------------------------------------------------------------------
# Optional: Postgres URL for `npm run test:db` (CI). Unset = temporary local cluster.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
