# Copy to .env.local and fill in. NEVER commit real values.
# Variables marked (Mx) are first used in that milestone.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (M1) — Project Settings → API Keys -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or legacy service_role key. SERVER ONLY. Bypasses RLS.
SUPABASE_SECRET_KEY=
# Project ref + personal access token (supabase.com/dashboard/account/tokens),
# used by `npm run db:migrate` and `npm run db:types`. Local/CI only — never deploy it.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Auth (M1) -----------------------------------------------------------------
# Set to true after configuring the Google provider in Supabase Auth.
AUTH_GOOGLE_ENABLED=false

# --- Links sent to parents + scheduled jobs ---------------------------------------
# 32+ random bytes each, e.g. `openssl rand -base64 48`
LINK_SECRET=
# Bearer token for /api/cron/weekly-summary (weekly) and /api/cron/cleanup (daily).
CRON_SECRET=

# --- WhatsApp Business Platform (Cloud API) ------------------------------------
# Empty → every message goes to /admin/whatsapp for one-tap manual sending.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Razorpay (M5) — use rzp_test_… keys in development ---------------------
# All three empty → MOCK gateway (only on localhost, or with PAYMENTS_ALLOW_MOCK=true).
# All three set → real Razorpay. See docs/SETUP.md "Payments".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Never set this in production.
PAYMENTS_ALLOW_MOCK=false

# --- Email via Resend (M5/M7) -------------------------------------------------
# Empty → emails are only logged (email_log table + server console).
RESEND_API_KEY=
EMAIL_FROM="AI Learning Hub <hello@example.com>"

# --- Marketing tags (optional) ---------------------------------------------------
# Loaded ONLY on the parent landing pages (/ and /lp/*), only after cookie consent,
# and never for signed-in users. Leave empty to load nothing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Storage buckets (M3/M5) ----------------------------------------------------
SUPABASE_INVOICES_BUCKET=invoices
SUPABASE_SUBMISSIONS_BUCKET=submissions

# --- Testing ------------------------------------------------------------------
# Optional: Postgres URL for `npm run test:db` (CI). Unset = temporary local cluster.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
